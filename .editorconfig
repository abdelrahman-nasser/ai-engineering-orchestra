root = true

# ============================================
# AI Engineering Orchestra
# Shared editor configuration
# ============================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# YAML
[*.{yaml,yml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# PowerShell
[*.{ps1,psm1,psd1}]
indent_size = 4

# C#
[*.cs]
indent_size = 4

# XML and XML-based project files
[*.{xml,csproj,props,targets}]
indent_size = 2

# JavaScript / TypeScript
[*.{js,mjs,cjs,ts,tsx}]
indent_size = 2

# Shell
[*.sh]
indent_size = 2
