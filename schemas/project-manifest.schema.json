{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Orchestra Project Manifest",
  "description": "Machine-readable schema for Project Manifest schema version 0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "orchestra",
    "complexity",
    "risk",
    "execution",
    "human_control",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1",
      "description": "Project Manifest contract version."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "greenfield",
            "brownfield",
            "modernization",
            "maintenance"
          ]
        }
      }
    },
    "orchestra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode"
      ],
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": [
            "lite",
            "standard",
            "deep",
            "critical"
          ]
        }
      }
    },
    "human_control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "final_review_required": {
          "type": "boolean"
        },
        "architecture_changes_require_approval": {
          "type": "boolean"
        },
        "breaking_schema_changes_require_approval": {
          "type": "boolean"
        },
        "breaking_contract_changes_require_approval": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_independent_review": {
          "type": "boolean"
        },
        "require_documentation_consistency": {
          "type": "boolean"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "const": "progressive",
          "default": "progressive"
        },
        "prefer_relevant_only": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "project_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
          "default": ".ai/rules/"
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
          "default": ".ai/tasks/"
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
          "default": ".ai/overrides/"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
          },
          {
            "not": {
              "pattern": "^orchestra\\."
            }
          }
        ]
      },
      "additionalProperties": true
    }
  }
}
